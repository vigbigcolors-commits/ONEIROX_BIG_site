{
  "name": "oneirox-site",
  "version": "0.1.0",
  "private": true,
  "description": "Oneirox — Sleep Neurobiology Lab",
  "scripts": {
    "dev": "npx --yes serve public -p 3000",
    "preview": "npx --yes serve public -p 3000",
    "favicons": "node scripts/generate-favicons.mjs",
    "pseo:expand": "node pseo/scripts/expand-matrix.mjs --target=400 --indexable=50",
    "pseo:enrich": "node pseo/scripts/enrich-matrix.mjs",
    "pseo:audit": "node pseo/scripts/audit-uniqueness.mjs",
    "pseo:dreams:build": "node pseo/scripts/build-dreams-ssg.mjs",
    "pseo:build": "node pseo/scripts/audit-uniqueness.mjs && node pseo/scripts/build-somatic-ssg.mjs && node pseo/scripts/link-mechanics-pillars.mjs && node pseo/scripts/build-dreams-ssg.mjs",
    "pseo:link-mechanics": "node pseo/scripts/link-mechanics-pillars.mjs",
    "pseo:index": "node pseo/scripts/submit-indexing.mjs --source=all --limit=50",
    "pseo:index:dreams": "node pseo/scripts/submit-indexing.mjs --source=dreams --limit=50",
    "pseo:index:dry": "node pseo/scripts/submit-indexing.mjs --source=dreams --dry-run",
    "pseo:indexnow": "node pseo/scripts/submit-indexnow.mjs",
    "pseo:indexnow:dreams": "node pseo/scripts/submit-indexnow.mjs --dreams",
    "pseo:notify": "npm run pseo:index:dreams && npm run pseo:indexnow:dreams",
    "pseo:all": "npm run pseo:expand && npm run pseo:enrich && npm run pseo:build"
  }
}
